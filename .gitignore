# Ignore python cache and byte code
*.py[cod]
__pycache__/

# Ignore user configuration file
*.ini

# Ignore user log file
*.log

# Ignore custom user panels
user/customPanels.kv
user/customPanels.py

# Ignore source graphics folder
graphics/

# Ignore Python virtual environment
venv/

# Ignore machine-specific local dev launch config (web UI preview)
.claude/launch.json

# Ignore local dev-preview WeatherFlow credentials (never commit secrets)
tools/dev_credentials.json

# Ignore local dev-preview settings scratch file
tools/dev_settings.json
